APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_SECRET=SomeRandomSecretKeyForCSRF_ChangeThis

# Configuración de Correo (PHPMailer)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=tu_usuario
SMTP_PASS=tu_contraseña
SMTP_FROM_EMAIL=hello@rakuncms.com
SMTP_FROM_NAME="RakunCMS Dev"

# Plesk Deployment (referenced from config/deploy.yaml as ${PLESK_*})
PLESK_HOST=
PLESK_API_KEY=
PLESK_WEBHOOK_URL=

# Plesk Sandbox Integration Tests (optional — tests skip if any is empty)
# PLESK_TEST_HOST: hostname only, no scheme/port (e.g. plesk.example.com)
# PLESK_TEST_API_KEY: admin-level API key
# PLESK_TEST_DOMAIN: a domain known to exist on the sandbox
# PLESK_TEST_VERIFY_SSL=1 enables SSL verification (default off for self-signed)
PLESK_TEST_HOST=
PLESK_TEST_API_KEY=
PLESK_TEST_DOMAIN=
PLESK_TEST_VERIFY_SSL=0
